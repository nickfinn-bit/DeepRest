    "build:strict": "node scripts/build.mjs --strict",
    "serve": "node scripts/serve.mjs",
    "verify": "node scripts/verify/run-all.mjs",
    "verify:live": "node scripts/verify/run-all.mjs --live",
    "verify:hosting": "node scripts/verify/live.mjs",
    "verify:calendly": "node scripts/verify/calendly.mjs",
